---
import Breadcrumbs from "@/components/extended/breadcrumbs.astro";
import SkillCard from "@/components/extended/skill-card.astro";
import TopicTag from "@/components/extended/topic-tag.astro";
import { skills } from "@/data/skills";
import { topics } from "@/data/topics";
import Layout from "@/layouts/Layout.astro";

const breadcrumbItems = [{ label: "home", href: "/" }, { label: "skills" }];

const sortedSkills = [...skills].sort((a, b) =>
  a.pathSlug.localeCompare(b.pathSlug),
);

const topicBadges = topics
  .map((topic) => {
    const count = sortedSkills.filter((skill) =>
      skill.topics?.includes(topic.slug),
    ).length;
    return {
      slug: topic.slug,
      label: topic.label,
      count,
      href: `/skills/${topic.slug}`,
    };
  })
  .filter((topic) => topic.count > 0);

const siteOrigin =
  Astro.site ?? new URL("https://skills.nabinkhair.com.np");
const skillsIndexUrl = new URL("/skills", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "skills by nabin khair",
  description: "browse all available skills.",
  url: skillsIndexUrl,
  hasPart: {
    "@type": "ItemList",
    itemListElement: sortedSkills.map((skill, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/skills/${skill.pathSlug}`, siteOrigin).toString(),
      name: skill.label,
    })),
  },
};
---

<Layout
  structuredData={structuredData}
  title="all skills | nabin khair"
  description="browse all available skills for product engineers."
>
  <div
    class="relative flex min-h-dvh flex-col items-center justify-start px-0 sm:px-4"
  >
    <div class="relative mt-20 w-full max-w-3xl sm:px-0">
      <div class="mx-auto flex w-full flex-col gap-10">
        <Breadcrumbs items={breadcrumbItems} />

        <div>
          <h1
            class="px-4 font-heading text-3xl font-medium tracking-tight text-foreground sm:px-0"
          >
            all skills
          </h1>
          <p class="mt-3 px-4 text-[15px] text-muted-foreground sm:px-0">
            {sortedSkills.length} skills available.
          </p>
          {
            topicBadges.length > 0 ? (
              <div class="mt-5 flex flex-wrap gap-2 px-4 sm:px-0">
                {topicBadges.map((topic) => (
                  <TopicTag
                    href={topic.href}
                    label={topic.label}
                    count={topic.count}
                  />
                ))}
              </div>
            ) : null
          }
        </div>

        <div class="grid gap-4 px-4 sm:grid-cols-2 sm:px-0">
          {
            sortedSkills.map((skill) => (
              <SkillCard
                href={`/skills/${skill.pathSlug}`}
                slug={skill.slug}
                description={skill.description}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
