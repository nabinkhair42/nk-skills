---
import Layout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<Layout
  title="page not found | nabin khair skills"
  description="the page you requested could not be found."
  robots="noindex,follow"
>
  <div
    class="relative flex min-h-dvh flex-col items-center justify-center px-4"
  >
    <div class="w-full max-w-2xl text-center">
      <p class="text-sm text-muted-foreground">404</p>
      <h1
        class="mt-2 font-heading text-3xl font-medium tracking-tight text-foreground"
      >
        page not found
      </h1>
      <p class="mt-3 text-[15px] text-muted-foreground">
        this link does not exist anymore or was moved.
      </p>
      <div
        class="mt-6 flex items-center justify-center gap-5 text-sm font-medium"
      >
        <a
          href="/"
          class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
        >
          home
        </a>
        <a
          href="/skills"
          class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
        >
          browse skills
        </a>
      </div>
    </div>
  </div>
</Layout>
