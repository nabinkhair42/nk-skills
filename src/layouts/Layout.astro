---
import "@/styles/global.css";
import { ThemeToggle } from "@/components/extended/theme-toggle";
import { SkillSearch } from "@/components/extended/skill-search";
import { Button } from "@/components/ui/button";
import { skills } from "@/data/skills";

const searchItems = skills.map((s) => ({
  slug: s.slug,
  pathSlug: s.pathSlug,
  label: s.label,
  description: s.description,
  topics: s.topics,
}));

type Props = {
  llmsPath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  title?: string;
  description?: string;
  robots?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
};

const {
  llmsPath,
  structuredData,
  title,
  description,
  robots,
  ogImage,
  ogImageAlt,
  ogType,
} = Astro.props as Props;

const currentYear = new Date().getFullYear();
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://skills.nabinkhair.com.np",
);
const pageTitle = title ?? "skills by nabin khair";
const pageDescription =
  description ?? "reusable skills for product engineers, by nabin khair.";
const robotsContent =
  robots ??
  "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const ogImageUrl = ogImage ?? "https://skills.nabinkhair.com.np/og.png";
const ogImageAltText = ogImageAlt ?? "skills by nabin khair";
const ogTypeValue = ogType ?? "website";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl.href} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robotsContent} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta property="og:type" content={ogTypeValue} />
    <meta property="og:site_name" content="nabin khair skills" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAltText} />
    {
      structuredData ? (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      ) : null
    }
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        var d = !t && window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (t === "dark" || d) document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body>
    <div class="relative min-h-dvh">
      <header class="flex items-center justify-between px-6 pt-6 sm:px-8">
        <a href="/" class="font-heading text-foreground text-sm font-medium">
          skills.nk
        </a>
        <nav class="flex items-center gap-3 text-sm sm:gap-6">
          <a
            href="/skills"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            skills
          </a>
          <SkillSearch items={searchItems} client:load />
          <ThemeToggle client:load />
          <Button variant="ghost" size="icon-sm">
            <a
              href="https://github.com/nabinkhair42/nk-skills"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              <svg
                aria-label="GitHub"
                class="size-4"
                viewBox="0 0 98 96"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M41.4395 69.3848C28.8066 67.8535 19.9062 58.7617 19.9062 46.9902C19.9062 42.2051 21.6289 37.0371 24.5 33.5918C23.2559 30.4336 23.4473 23.7344 24.8828 20.959C28.7109 20.4805 33.8789 22.4902 36.9414 25.2656C40.5781 24.1172 44.4062 23.543 49.0957 23.543C53.7852 23.543 57.6133 24.1172 61.0586 25.1699C64.0254 22.4902 69.2891 20.4805 73.1172 20.959C74.457 23.543 74.6484 30.2422 73.4043 33.4961C76.4668 37.1328 78.0937 42.0137 78.0937 46.9902C78.0937 58.7617 69.1934 67.6621 56.3691 69.2891C59.623 71.3945 61.8242 75.9883 61.8242 81.252L61.8242 91.2051C61.8242 94.0762 64.2168 95.7031 67.0879 94.5547C84.4102 87.9512 98 70.6289 98 49.1914C98 22.1074 75.9883 0 48.9043 0C21.8203 0 0 22.1074 0 49.1914C0 70.4375 13.4941 88.0469 31.6777 94.6504C34.2617 95.6074 36.75 93.8848 36.75 91.3008L36.75 83.6445C35.4102 84.2188 33.6875 84.6016 32.1562 84.6016C25.8398 84.6016 22.1074 81.1563 19.4277 74.7441C18.375 72.1602 17.2266 70.6289 15.0254 70.3418C13.877 70.2461 13.4941 69.7676 13.4941 69.1934C13.4941 68.0449 15.4082 67.1836 17.3223 67.1836C20.0977 67.1836 22.4902 68.9063 24.9785 72.4473C26.8926 75.2227 28.9023 76.4668 31.2949 76.4668C33.6875 76.4668 35.2187 75.6055 37.4199 73.4043C39.0469 71.7773 40.291 70.3418 41.4395 69.3848Z"
                ></path>
              </svg>
            </a>
          </Button>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer
        class="text-muted-foreground flex w-full items-center justify-center gap-3 px-4 pt-24 pb-6 text-center text-sm"
      >
        <span>
          <span>&copy;{currentYear}</span>
          <a
            href="https://nabinkhair.com.np"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-foreground"
          >
            nabin khair
          </a>
        </span>
        {llmsPath ? <span class="text-border">·</span> : null}
        {
          llmsPath ? (
            <a href={llmsPath} class="hover:text-foreground">
              llms.txt
            </a>
          ) : null
        }
      </footer>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
