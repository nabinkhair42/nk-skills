---
import { CopyButton } from "./copy-button";

type Props = {
  lines?: Array<Array<{ text: string; className?: string }>>;
  copyContent?: string;
  align?: "start" | "center";
  truncate?: boolean;
  className?: string;
  id?: string;
};

const {
  lines = [],
  copyContent,
  align = "start",
  truncate = false,
  className = "",
  id,
} = Astro.props as Props;
const content =
  copyContent ??
  lines.map((line) => line.map((segment) => segment.text).join("")).join("\n");
const alignClass = align === "center" ? "items-center" : "items-start";
const preClass = truncate
  ? "m-0 min-w-0 flex-1 overflow-hidden text-ellipsis whitespace-nowrap pr-3 font-mono text-[15px] leading-6"
  : "m-0 font-mono text-[15px] leading-6";
---

<div
  id={id}
  data-copy-block={content}
  class={`relative flex flex-col sm:flex-row justify-between rounded-lg bg-muted py-2 pr-4 pl-6 gap-2 sm:gap-0 cursor-copy ${alignClass} ${className}`}
>
  <pre class={preClass}><code>{lines.map((line, lineIndex) => (
    <>
      {line.map((segment) => (
        <span class={segment.className}>{segment.text}</span>
      ))}
      {lineIndex < lines.length - 1 ? <br /> : null}
    </>
  ))}</code></pre>
  <div class="flex items-center gap-1">
    <CopyButton
      value={content}
      size="sm"
      client:load
    />
  </div>
  <slot />
</div>

<script is:inline>
  document.querySelectorAll("[data-copy-block]").forEach(function (block) {
    block.addEventListener("click", function (e) {
      if (e.target.closest("button")) return;
      var btn = block.querySelector("button");
      if (btn) btn.click();
    });
  });
</script>
