---
import { CopyButton } from "./copy-button";

type Props = {
  copyContent: string;
  name?: string;
  description?: string;
};

const { copyContent, name, description } = Astro.props as Props;
const hasFrontmatter = Boolean(name ?? description);
---

<div
  class="relative w-full rounded-lg border border-border bg-card pt-6 pr-4 pb-4 pl-6 overflow-hidden"
>
  <div class="absolute top-3 right-3">
    <CopyButton value={copyContent} size="sm" client:load />
  </div>
  <div
    class="prose prose-neutral dark:prose-invert prose-headings:text-balance prose-headings:font-medium prose-headings:text-[15px] prose-h1:mt-0 prose-h1:mb-6 prose-h1:text-[18px] prose-h2:mt-8 prose-h2:mb-3 prose-p:my-3 prose-p:font-normal prose-p:text-[14px] prose-p:text-muted-foreground prose-p:text-pretty prose-ul:my-3 prose-li:my-1.5 prose-li:pl-0 prose-li:font-normal prose-li:text-[14px] prose-li:text-muted-foreground prose-li:marker:text-muted-foreground/50 prose-pre:rounded-lg prose-pre:p-4 prose-pre:text-[13px] max-w-none font-mono"
  >
    {
      hasFrontmatter ? (
        <div class="mb-8 text-[14px] text-muted-foreground">
          <div>---</div>
          {name ? <div>name: {name}</div> : null}
          {description ? <div>description: {description}</div> : null}
          <div>---</div>
        </div>
      ) : null
    }
    <slot />
  </div>
</div>

<style>
  .prose :where(a):not(:where([class~="not-prose"], [class~="not-prose"] *)) {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
