---
import { ArrowLeft02Icon, ArrowRight02Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

type Props = {
  previousHref?: string;
  nextHref?: string;
};

const { previousHref, nextHref } = Astro.props as Props;
---

<script is:inline define:vars={{ previousHref, nextHref }}>
  document.addEventListener("keydown", function (e) {
    if (
      e.target instanceof HTMLInputElement ||
      e.target instanceof HTMLTextAreaElement ||
      e.target.isContentEditable
    ) return;
    if (e.key === "ArrowLeft" && previousHref) {
      window.location.href = previousHref;
    }
    if (e.key === "ArrowRight" && nextHref) {
      window.location.href = nextHref;
    }
  });
</script>

<div
  class="border-border bg-card inline-flex items-stretch overflow-hidden rounded-md border"
>
  {
    previousHref ? (
      <a
        href={previousHref}
        aria-label="Previous skill"
        class="text-muted-foreground hover:bg-accent hover:text-foreground inline-flex size-8 items-center justify-center transition-colors"
      >
        <HugeiconsIcon icon={ArrowLeft02Icon} />
      </a>
    ) : (
      <span
        aria-label="Previous skill unavailable"
        class="text-muted-foreground/30 inline-flex size-8 items-center justify-center"
      >
        <HugeiconsIcon icon={ArrowLeft02Icon} />
      </span>
    )
  }
  <span class="bg-border w-px self-stretch" aria-hidden="true"></span>
  {
    nextHref ? (
      <a
        href={nextHref}
        aria-label="Next skill"
        class="text-muted-foreground hover:bg-accent hover:text-foreground inline-flex size-8 items-center justify-center transition-colors"
      >
        <HugeiconsIcon icon={ArrowRight02Icon} />
      </a>
    ) : (
      <span
        aria-label="Next skill unavailable"
        class="text-muted-foreground/30 inline-flex size-8 items-center justify-center"
      >
        <HugeiconsIcon icon={ArrowRight02Icon} />
      </span>
    )
  }
</div>
