---
type Props = {
  href: string;
  slug: string;
  description?: string;
};

const { href, slug, description } = Astro.props as Props;
---

<a
  href={href}
  class="relative flex flex-col justify-between rounded-lg dark:border dark:border-border dark:bg-none px-6 py-4 bg-accent  transition-colors hover:border-input hover:bg-accent"
>
  <div class="flex flex-col gap-3">
    <div class="font-heading text-[15px] font-medium tracking-tight text-foreground">
      {slug}
    </div>
    {
      description ? (
        <div class="line-clamp-3 text-[14px] leading-snug text-muted-foreground">
          {description}
        </div>
      ) : null
    }
  </div>
</a>
